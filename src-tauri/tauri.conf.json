{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kizuna",
  "version": "0.4.2",
  "identifier": "app.kizuna.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kizuna",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#ef98a6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ohimeee",
    "copyright": "Kizuna contributors. Apache-2.0.",
    "category": "Utility",
    "shortDescription": "Light novel reader",
    "longDescription": "Kizuna Desktop: read light novels from the same source plugins as the Kizuna Android app.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNThCMkU3NDNCMzAwOEQKUldTTkFMTkQ1N0pZSDUrQ0NsZCtOS05QZzZ1YVpMZ1d1b3graGwwNmFpUnpsQzQ4UUlpL0dxb0YK",
      "endpoints": [
        "https://github.com/ohimeee/Kizuna-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
